# Required — Firebase web app config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sales-presentation-portal
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Production hosting origin (used for invite/email links in the browser)
VITE_APP_ORIGIN=https://presentationhub.web.app

# Must be false in production builds
VITE_USE_EMULATORS=false

# App Check (temporary exception until enabled — see docs/APP_CHECK.md)
VITE_USE_APP_CHECK=false
VITE_RECAPTCHA_SITE_KEY=

# Cloud Functions runtime (set in functions/.env or Firebase secrets):
# APP_ORIGIN=https://presentationhub.web.app
#
# Google Workspace OAuth (Gmail + Calendar) — never commit real secrets:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://presentationhub.web.app/oauth/google/calendar
# GOOGLE_CALENDAR_TOKEN_KEY=
#
# Legacy aliases (still accepted):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
