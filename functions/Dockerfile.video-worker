# Long-running FFmpeg worker for Sales Presentation Portal.
# Deployed as Cloud Run Job `spp-video-process` (not Cloud Functions).
FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY lib ./lib

ENV NODE_ENV=production
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV FFPROBE_PATH=/usr/bin/ffprobe

# Cloud Run Jobs inject VIDEO_ID / PROCESSING_* at execution time.
CMD ["node", "lib/workerEntry.js"]
